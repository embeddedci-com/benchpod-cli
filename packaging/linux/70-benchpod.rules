# BenchPod: keep ModemManager off the pod's USB console, and let the signed-in desktop user open it
# (uaccess) without joining the dialout group.
# Install: sudo cp 70-benchpod.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# Every STM32 firmware, 3.9.0 included: ST's stock CDC ID.
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
# Pre-release 3.9.0 builds (pid.codes test ID).
ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
