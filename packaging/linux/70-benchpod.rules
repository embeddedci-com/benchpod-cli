# BenchPod: keep ModemManager off the pod's USB console.
# Install: sudo cp 70-benchpod.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# Firmware 3.9.0 and later (pid.codes VID 1209; PID 0001 is the test ID until ours is assigned).
ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ENV{ID_MM_DEVICE_IGNORE}="1"
# Older firmware (ST's stock CDC ID).
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ENV{ID_MM_DEVICE_IGNORE}="1"
