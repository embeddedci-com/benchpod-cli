{"format":1,"kind":"i2c","name":"sht3x","label":"Sensirion SHT3x: temperature and humidity","description":"Single-shot measurements without clock stretching (0x2400, 0x240B, 0x2416: high, medium and\nlow repeatability; reads are not acknowledged until the measurement time has passed, as on the\npart), the clock-stretching ones (0x2C06, 0x2C0D, 0x2C10: the answer is ready at once, so the\npod never needs to stretch), periodic mode (every 0x20xx..0x27xx and ART command is\nacknowledged; fetch data 0xE000 returns the current reading), the status register (0xF32D),\nthe serial number (0x3780 and 0x3682), break (0x3093), soft reset (0x30A2), heater on/off and\nclear status. Each answer word comes with its CRC-8.\n\nThe status register reads 0x8010 (alert pending, reset detected) and does not follow the heater\nor clear-status commands; the soft reset changes nothing.\n","datasheet":"https://sensirion.com/products/catalog/SHT31-DIS-B","version":"1.0.0","license":"Apache-2.0","params":[{"key":"temperature_c","unit":"C","min":-40,"max":125,"default":25,"label":"Temperature"},{"key":"humidity_pct","unit":"%","min":0,"max":100,"default":40,"label":"Humidity"}],"i2c":{"address":68,"alt_addresses":[69],"register_address_bits":16},"functions":{"word_crc":{"args":["w","n"],"return":"n == 0 ? byte(w, 1) : n == 1 ? byte(w, 0) : crc8(0x31, 0xFF, byte(w, 1), byte(w, 0))"}},"let":[{"st":"sat_u16((temperature_c + 45) * 65535 / 175)"},{"srh":"sat_u16(humidity_pct * 65535 / 100)"}],"commands":[{"command":9216,"busy_us":15000,"answer":["word_crc(st, 0)","word_crc(st, 1)","word_crc(st, 2)","word_crc(srh, 0)","word_crc(srh, 1)","word_crc(srh, 2)"]},{"command":9227,"busy_us":6000,"answer":["word_crc(st, 0)","word_crc(st, 1)","word_crc(st, 2)","word_crc(srh, 0)","word_crc(srh, 1)","word_crc(srh, 2)"]},{"command":9238,"busy_us":4000,"answer":["word_crc(st, 0)","word_crc(st, 1)","word_crc(st, 2)","word_crc(srh, 0)","word_crc(srh, 1)","word_crc(srh, 2)"]},{"command":11270,"answer":["word_crc(st, 0)","word_crc(st, 1)","word_crc(st, 2)","word_crc(srh, 0)","word_crc(srh, 1)","word_crc(srh, 2)"]},{"command":11277,"answer":["word_crc(st, 0)","word_crc(st, 1)","word_crc(st, 2)","word_crc(srh, 0)","word_crc(srh, 1)","word_crc(srh, 2)"]},{"command":11280,"answer":["word_crc(st, 0)","word_crc(st, 1)","word_crc(st, 2)","word_crc(srh, 0)","word_crc(srh, 1)","word_crc(srh, 2)"]},{"command":57344,"answer":["word_crc(st, 0)","word_crc(st, 1)","word_crc(st, 2)","word_crc(srh, 0)","word_crc(srh, 1)","word_crc(srh, 2)"]},{"command":62253,"answer":["word_crc(0x8010, 0)","word_crc(0x8010, 1)","word_crc(0x8010, 2)"]},{"command":14208,"answer":["word_crc(0x1A2B, 0)","word_crc(0x1A2B, 1)","word_crc(0x1A2B, 2)","word_crc(0x3C4D, 0)","word_crc(0x3C4D, 1)","word_crc(0x3C4D, 2)"]},{"command":13954,"answer":["word_crc(0x1A2B, 0)","word_crc(0x1A2B, 1)","word_crc(0x1A2B, 2)","word_crc(0x3C4D, 0)","word_crc(0x3C4D, 1)","word_crc(0x3C4D, 2)"]},{"command":8242},{"command":8228},{"command":8239},{"command":8496},{"command":8486},{"command":8493},{"command":8758},{"command":8736},{"command":8747},{"command":9012},{"command":8994},{"command":9001},{"command":10039},{"command":10017},{"command":10026},{"command":11058},{"command":12435},{"command":12450},{"command":12397},{"command":12390},{"command":12353}]}
